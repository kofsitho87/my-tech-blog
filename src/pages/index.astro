---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import GoogleTagManagerNoscript from '../components/GoogleTagManagerNoscript.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, pathWithBase } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="ko">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<GoogleTagManagerNoscript />
		<Header />
		<main>
			<section class="hero reveal">
				<div class="hero-copy">
					<p class="eyebrow">Developer notes · Seoul</p>
					<h1>생각은<br /><em>코드가 되고,</em><br />코드는 기록이 된다.</h1>
				</div>
				<div class="hero-note">
					<span class="line-number">01</span>
					<p>{SITE_DESCRIPTION}. 시행착오까지 숨기지 않고 오래 남길 지식을 씁니다.</p>
					<a href={pathWithBase('blog/')}>모든 글 읽기 <span>→</span></a>
				</div>
			</section>

			<section class="latest reveal reveal-delay">
				<header class="section-head">
					<p class="eyebrow">Recently compiled</p>
					<h2>최근 기록</h2>
				</header>
				<div class="post-list">
					{posts.map((post, index) => (
						<a class="post-row" href={pathWithBase(`blog/${post.id}/`)}>
							<span class="index">0{index + 1}</span>
							<div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
							<time><FormattedDate date={post.data.pubDate} /></time>
							<span class="arrow">↗</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { min-height: 70vh; display: grid; grid-template-columns: 2.1fr 1fr; align-items: end; gap: 4rem; padding-bottom: 7rem; }
	.hero h1 { max-width: 850px; font-weight: 500; }
	.hero h1 em { color: var(--accent); font-weight: 400; }
	.hero-note { padding-top: 1rem; border-top: 1px solid var(--ink); }
	.hero-note .line-number { display: block; color: var(--muted); font-size: .7rem; margin-bottom: 2rem; }
	.hero-note a { display: inline-flex; justify-content: space-between; width: 100%; color: var(--ink); font-weight: 700; text-decoration: none; }
	.hero-note a:hover { color: var(--accent); }
	.section-head { display: flex; align-items: end; justify-content: space-between; padding-bottom: 1.5rem; border-bottom: 2px solid var(--ink); }
	.section-head p { order: 2; }
	.section-head h2 { margin: 0; }
	.post-row { display: grid; grid-template-columns: 40px 1fr auto 28px; gap: 1.25rem; align-items: center; padding: 1.7rem .2rem; border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: padding .2s, background .2s; }
	.post-row:hover { padding-inline: 1rem; background: var(--paper-deep); color: var(--ink); }
	.post-row h3 { margin: 0 0 .2rem; font-size: 1.5rem; }
	.post-row p, .post-row time, .index { margin: 0; color: var(--muted); font-size: .85rem; }
	.arrow { color: var(--accent); font-size: 1.2rem; }
	@media (max-width: 720px) {
		.hero { min-height: auto; grid-template-columns: 1fr; gap: 2.5rem; padding-bottom: 5rem; }
		.hero-note { max-width: 400px; }
		.post-row { grid-template-columns: 28px 1fr 20px; gap: .7rem; }
		.post-row time { display: none; }
		.post-row h3 { font-size: 1.25rem; }
	}
</style>
