---
import { GITHUB_URL, SITE_TITLE, pathWithBase } from '../consts';
const today = new Date();
---

<footer>
	<div><strong>{SITE_TITLE}</strong><span>© {today.getFullYear()}</span></div>
	<div class="footer-links">
		<a href={pathWithBase('rss.xml')}>RSS</a>
		<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
	</div>
</footer>
<style>
	footer {
		max-width: var(--page);
		margin: 3rem auto 0;
		padding: 2rem 1.5rem 4rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: .8rem;
		display: flex;
		justify-content: space-between;
	}
	footer div, .footer-links { display: flex; gap: 1rem; }
	footer a { color: inherit; text-decoration: none; }
	footer a:hover { color: var(--accent); }
</style>
